# ===== LOCAL OLLAMA =====
OLLAMA_HOST=http://127.0.0.1:11434
ALLOW_REMOTE_OLLAMA=false

LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_THINK=false

# Embedding
EMBED_MODEL=bge-m3
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=

# ===== RETRIEVAL =====
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_CANDIDATE_K=30
RAG_MIN_SCORE=0.30
VECTOR_WEIGHT=0.80
LEXICAL_WEIGHT=0.20
RAG_MAX_CHUNKS_PER_SOURCE=3

# pypdf = stable page citations; docling = better tables/layout but may lose page provenance
PARSER=pypdf
RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_FACTOR=3

# ===== MULTIMODAL (optional) =====
# Set a local vision model, e.g. one supported by your Ollama installation.
VISION_ENABLED=false
VISION_MODEL=

# ===== PATHS =====
RAG_RAW_DIR=data/raw
RAG_DB_DIR=data/index

# ===== EVALUATION =====
JUDGE_MODEL=
